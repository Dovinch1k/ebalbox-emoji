# Токен вашего Discord бота (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID приложения (Discord Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=your_client_id_here

# Client Secret (Discord Developer Portal -> OAuth2 -> Client Secret)
DISCORD_CLIENT_SECRET=your_client_secret_here

# URL обратного вызова OAuth2
# Для локальной разработки: http://localhost:3000/auth/callback
# Для Render: https://your-service-name.onrender.com/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Секретный ключ для сессий браузера (любая случайная длинная строка)
SESSION_SECRET=super_secret_session_key_random_string_change_this

# Порт веб-сервера (на Render задается автоматически)
PORT=3000

# Режим окружения
NODE_ENV=development
